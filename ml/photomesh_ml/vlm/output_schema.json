{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PhotoMesh circuit",
  "type": "object",
  "properties": {
    "error": {"type": "string", "enum": ["no_circuit"]},
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "type": {"type": "string", "enum": ["resistor", "voltage_source", "current_source", "battery", "lamp", "capacitor", "inductor", "switch_open", "switch_closed"]},
          "value": {"type": ["number", "null"]},
          "node_a": {"type": "string"}, "node_b": {"type": "string"},
          "positive_node": {"type": "string"}, "negative_node": {"type": "string"},
          "from_node": {"type": "string"}, "to_node": {"type": "string"},
          "box": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4},
          "orientation": {"type": "string", "enum": ["horizontal", "vertical"]}
        },
        "required": ["id", "type", "value", "box", "orientation"]
      }
    },
    "ground_node": {"type": "string"},
    "node_points": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}},
    "meshes": {"type": "array", "items": {"type": "array", "items": {"type": "string"}}},
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {"type": "string", "enum": ["current", "voltage", "power", "resistance"]},
          "element": {"type": "string"}, "node": {"type": "string"},
          "between": {"type": "array", "items": {"type": "string"}, "minItems": 2, "maxItems": 2}
        },
        "required": ["kind"]
      }
    },
    "question": {"type": ["string", "null"]},
    "unsupported": {"type": "array", "items": {"type": "string"}},
    "confidence": {"type": ["number", "null"]},
    "notes": {"type": ["string", "null"]}
  }
}
